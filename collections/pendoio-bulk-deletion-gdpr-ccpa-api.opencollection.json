          },
          "docs": "Bulk Delete Visitors"
        },
        {
          "info": {
            "name": "Bulk Delete Accounts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.pendo.io/api/v1/bulkdelete/account",
