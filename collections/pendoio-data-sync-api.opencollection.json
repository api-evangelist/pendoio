{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pendo Engage Account Data Sync API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-pendo-integration-key",
      "value": "{{x-pendo-integration-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data Sync",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Rotate Credentials for GCS Destination",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.pendo.io/api/v1/datasync/storageTypes/gcs/destinations/Default/credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rotate Credentials for GCS Destination"
        },
        {
          "info": {
            "name": "Rotate Credentials for S3 Destination",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.pendo.io/api/v1/datasync/storageTypes/s3/destinations/Default/credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rotate Credentials for S3 Destination"
        },
        {
          "info": {
            "name": "Rotate Credentials for Azure Destination",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.pendo.io/api/v1/datasync/storageTypes/azure/destinations/Default/credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rotate Credentials for Azure Destination"
        }
      ]
    }
  ],
  "bundled": true
}