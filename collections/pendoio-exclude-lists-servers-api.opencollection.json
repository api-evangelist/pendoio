{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pendo Engage Account Exclude Lists & Servers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-pendo-integration-key",
      "value": "{{x-pendo-integration-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exclude Lists & Servers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all excluded items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/blacklist"
          },
          "docs": "Get all excluded items"
        },
        {
          "info": {
            "name": "Get all excluded items by type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/blacklist/type/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get all excluded items by type"
        },
        {
          "info": {
            "name": "Get all servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/servername"
          },
          "docs": "Get all servers"
        },
        {
          "info": {
            "name": "Get server by name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/servername/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get server by name"
        },
        {
          "info": {
            "name": "Get server by flag name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/servername/flag/:flagname",
            "params": [
              {
                "name": "flagname",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get server by flag name"
        }
      ]
    }
  ],
  "bundled": true
}