{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pendo Engage Account Listen API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-pendo-integration-key",
      "value": "{{x-pendo-integration-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Listen",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get feedback options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/feedback/options"
          },
          "docs": "Get feedback options"
        },
        {
          "info": {
            "name": "Create new feedback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.pendo.io/api/v1/feedback",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new feedback"
        },
        {
          "info": {
            "name": "Delete feedback",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.pendo.io/api/v1/feedback"
          },
          "docs": "Delete feedback"
        },
        {
          "info": {
            "name": "Update existing feedback",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.pendo.io/api/v1/feedback/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update existing feedback"
        }
      ]
    }
  ],
  "bundled": true
}