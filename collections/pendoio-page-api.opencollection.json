{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pendo Engage Account Page API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-pendo-integration-key",
      "value": "{{x-pendo-integration-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Page",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return List of All Pages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/page"
          },
          "docs": "Return List of All Pages"
        }
      ]
    }
  ],
  "bundled": true
}