{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pendo Engage Account Report API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-pendo-integration-key",
      "value": "{{x-pendo-integration-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return a List of Public Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/report"
          },
          "docs": "Return a List of Public Reports"
        },
        {
          "info": {
            "name": "Return Report Contents as Array of JSON Objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/report/:reportId/results.json",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return Report Contents as Array of JSON Objects"
        },
        {
          "info": {
            "name": "Return Report Contents as CSV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/report/:reportId/results.csv",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return Report Contents as CSV"
        }
      ]
    }
  ],
  "bundled": true
}