{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pendo Engage Account Track API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-pendo-integration-key",
      "value": "{{x-pendo-integration-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Track",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a Track Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.pendo.io/data/track",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send a Track Event"
        },
        {
          "info": {
            "name": "Return a List of All Track Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pendo.io/api/v1/tracktype"
          },
          "docs": "Return a List of All Track Types"
        }
      ]
    }
  ],
  "bundled": true
}